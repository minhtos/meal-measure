#!/bin/bash
# Project verification gate. Exit non-zero on ANY failure. On success the
# .claude/verify-ok marker is refreshed — the require-verify hook blocks
# `git commit` / `gh pr create` whenever a source file is newer than it.
# Stages (format → lint → typecheck → unit tests → build) run only when this
# project has them; a zero-dependency Node scaffold has no formatter, linter,
# typechecker, or build yet.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MARKER="$ROOT/.claude/verify-ok"
rm -f "$MARKER"

fail() { echo "verify: FAIL — $*" >&2; exit 1; }

# ---- STAGES ----
# 1. Project metadata parses.
node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$ROOT/.project.json" \
  || fail ".project.json is not valid JSON"
echo "verify: .project.json ok"

# 2. Integration design doc exists, is non-empty, and states the core rule.
DOC="$ROOT/docs/INTEGRATION.md"
[ -s "$DOC" ] || fail "docs/INTEGRATION.md missing or empty"
grep -q 'The model never calculates nutrient numbers\.' "$DOC" \
  || fail "docs/INTEGRATION.md lacks the 'The model never calculates nutrient numbers.' statement"
for section in 'Contract A' 'Contract B' 'Contract C' 'Module boundary' 'Smoke tests'; do
  grep -q "^## .*$section" "$DOC" || fail "docs/INTEGRATION.md lacks a '$section' section"
done
echo "verify: docs/INTEGRATION.md ok"

# 3. web/benchmark.json is regenerated from BENCHMARK.md (fails if the document's own numbers disagree).
node "$ROOT/scripts/build-benchmark.mjs" || fail "scripts/build-benchmark.mjs"

# 4. Unit / smoke tests (node:test), once any test files exist.
if [ -d "$ROOT/tests" ] && [ -n "$(find "$ROOT/tests" -name '*.test.js' -print -quit)" ]; then
  node --test "$ROOT/tests/**/*.test.js" || fail "node --test"
  echo "verify: node --test ok"
else
  echo "verify: no test files yet — unit test stage skipped"
fi
# ---- END STAGES ----

mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"
echo "verify: all stages passed"
