# meal-measure server configuration (copy to .env or export in your shell)
# No key is required: without META_API_KEY the app runs in mock mode and
# replays the recorded sample runs in data/samples/ (each with provenance).
META_API_KEY=
# USDA FoodData Central key (free): https://fdc.nal.usda.gov/api-key-signup
# Without it, live runs cannot resolve database entries.
USDA_API_KEY=
# Optional: PORT=8787 HOST=127.0.0.1 MEAL_MEASURE_MODE=live|mock
